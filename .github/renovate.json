{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "^Pipfile$"
      ],
      "matchStrings": [
        "python_full_version\\s*=\\s*\"(?<currentValue>[^\"]+)\"",
        "python_version\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "python",
      "datasourceTemplate": "python-version",
      "versioningTemplate": "python"
    }
  ],
  "labels": [
    "dependencies",
    "github-actions"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "python"
      ],
      "groupName": "python"
    }
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0
}
